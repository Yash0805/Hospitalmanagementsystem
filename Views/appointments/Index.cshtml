@model IReadOnlyList<appointmentsViewModel>

@{
    ViewData["Title"] = "appointments Records";
}

<div class="container mt-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">appointments Records</h2>

        <a asp-controller="appointments"
           asp-action="Create"
           class="btn btn-primary">
            + Add appointments
        </a>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>appointments Id</th>
                <th>patient Id</th>
                <th>doctor ID </th>
                <th>appointment date</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.appointment_id</td>
                    <td>@a.patient_id</td>
                    <td>@a.doctor_id</td>
                    <td>@a.appointment_date</td>
                </tr>
            }
        </tbody>
    </table>
</div>