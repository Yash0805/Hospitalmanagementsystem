@model prescriptionsViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white text-center">
                    <h4>Prescriptions Registration</h4>
                </div>

                <div class="card-body">
                    <form method="post">

                        <!-- Patient Id -->
                        <div class="mb-3">
                            <label class="form-label">Patient Id </label>
                            <input type="number"
                                   name="patient_id"
                                   class="form-control"
                                   placeholder="Enter Patient Id"
                                   required />
                        </div>

                        <!-- Doctor Id -->
                        <div class="mb-3">
                            <label class="form-label">Doctor Id </label>
                            <input type="number"
                                   name="doctor_id"
                                   class="form-control"
                                   placeholder="Enter Doctor Id"
                                   required />
                        </div>

                        <!-- medicine Id -->
                        <div class="mb-3">
                            <label class="form-label">Medicine Id </label>
                            <input type="number"
                                   name="medicine_id"
                                   class="form-control"
                                   placeholder="Enter Medicine Id"
                                   required />
                        </div>

                        <!-- dosage -->
                        <div class="mb-3">
                            <label class="form-label"> dosage </label>
                            <input type="text"
                                   name="dosage"
                                   class="form-control"
                                   placeholder="Enter dosage "
                                   required />
                        </div>
                        <!-- Submit -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success">
                                Submit
                            </button>
                        </div>

                    </form>
                </div>

                <div class="card-footer text-center">
                    <a asp-controller="prescriptions"
                       asp-action="Index"
                       class="text-decoration-none">
                        View Index
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>