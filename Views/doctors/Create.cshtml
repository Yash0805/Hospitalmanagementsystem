@model doctorsViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white text-center">
                    <h4>doctors Registration</h4>
                </div>

                <div class="card-body">
                    <form method="post">

                        <!-- doctors Name -->
                        <div class="mb-3">
                            <label class="form-label">doctors Name </label>
                            <input type="text"
                                   name="doctor_name"
                                   class="form-control"
                                   placeholder="Enter Doctor Name"
                                   required />
                        </div>

                        <!-- specialization  -->
                        <div class="mb-3">
                            <label class="form-label">specialization  </label>
                            <input type="text"
                                   name="specialization"
                                   class="form-control"
                                   placeholder="Enter specialization Name"
                                   required />
                        </div>


                        <!-- Phone -->
                        <div class="mb-3">
                            <label class="form-label"> Phone </label>
                            <input type="text"
                                   name="Phone"
                                   class="form-control"
                                   placeholder="Enter Doctor Phone Number"
                                   required />
                        </div>
                        <!-- Submit -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success">
                                Submit
                            </button>
                        </div>

                    </form>
                </div>

                <div class="card-footer text-center">
                    <a asp-controller="patients"
                       asp-action="Index"
                       class="text-decoration-none">
                        View Index
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>