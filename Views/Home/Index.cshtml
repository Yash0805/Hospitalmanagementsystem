@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">

    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary">
            Hospital Management System
        </h1>
        <p class="lead text-muted">
            Manage patients, doctors, treatments, appointments, medicines,
            prescriptions, and billing from one place.
        </p>
    </div>

    <!-- Dashboard Cards -->
    <div class="row g-4">

        <!-- Patients -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card dashboard-card h-100 text-center">
                <div class="card-body">
                    <i class="bi bi-person-heart display-4 text-primary"></i>
                    <h5 class="mt-3">Patients</h5>
                    <p class="text-muted small">Manage patient records</p>
                    <a asp-controller="Patients" asp-action="Create"
                       class="btn btn-outline-primary btn-sm">
                        Open
                    </a>
                </div>
            </div>
        </div>

        <!-- Doctors -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card dashboard-card h-100 text-center">
                <div class="card-body">
                    <i class="bi bi-person-badge display-4 text-success"></i>
                    <h5 class="mt-3">Doctors</h5>
                    <p class="text-muted small">Doctor information</p>
                    <a asp-controller="Doctors" asp-action="Create"
                       class="btn btn-outline-success btn-sm">
                        Open
                    </a>
                </div>
            </div>
        </div>

        <!-- Treatments -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card dashboard-card h-100 text-center">
                <div class="card-body">
                    <i class="bi bi-clipboard-pulse display-4 text-warning"></i>
                    <h5 class="mt-3">Treatments</h5>
                    <p class="text-muted small">Treatment details</p>
                    <a asp-controller="Treatments" asp-action="Create"
                       class="btn btn-outline-warning btn-sm">
                        Open
                    </a>
                </div>
            </div>
        </div>

        <!-- Appointments -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card dashboard-card h-100 text-center">
                <div class="card-body">
                    <i class="bi bi-calendar-check display-4 text-info"></i>
                    <h5 class="mt-3">Appointments</h5>
                    <p class="text-muted small">Schedule visits</p>
                    <a asp-controller="Appointments" asp-action="Create"
                       class="btn btn-outline-info btn-sm">
                        Open
                    </a>
                </div>
            </div>
        </div>

        <!-- Medicines -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card dashboard-card h-100 text-center">
                <div class="card-body">
                    <i class="bi bi-capsule display-4 text-danger"></i>
                    <h5 class="mt-3">Medicines</h5>
                    <p class="text-muted small">Medicine inventory</p>
                    <a asp-controller="Medicines" asp-action="Create"
                       class="btn btn-outline-danger btn-sm">
                        Open
                    </a>
                </div>
            </div>
        </div>

        <!-- Prescriptions -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card dashboard-card h-100 text-center">
                <div class="card-body">
                    <i class="bi bi-file-earmark-medical display-4 text-secondary"></i>
                    <h5 class="mt-3">Prescriptions</h5>
                    <p class="text-muted small">Patient prescriptions</p>
                    <a asp-controller="Prescriptions" asp-action="Create"
                       class="btn btn-outline-secondary btn-sm">
                        Open
                    </a>
                </div>
            </div>
        </div>

        <!-- Bills -->
        <div class="col-lg-3 col-md-4 col-sm-6">
            <div class="card dashboard-card h-100 text-center">
                <div class="card-body">
                    <i class="bi bi-receipt display-4 text-dark"></i>
                    <h5 class="mt-3">Bills</h5>
                    <p class="text-muted small">Billing & payments</p>
                    <a asp-controller="Bills" asp-action="Create"
                       class="btn btn-outline-dark btn-sm">
                        Open
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
