@model IReadOnlyList<patientsViewModel>

@{
    ViewData["Title"] = "patients Records";
}

<div class="container mt-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">patients Records</h2>

        <a asp-controller="patients"
           asp-action="Create"
           class="btn btn-primary">
            + Add patients
        </a>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Patients Id</th>
                <th>Patients Name</th>
                <th>Gender</th>
                <th>Age</th>
                <th>Phone</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.patient_id</td>
                    <td>@p.patient_name</td>
                    <td>@p.gender</td>
                    <td>@p.age</td>
                    <td>@p.phone</td>
                </tr>
            }
        </tbody>
    </table>
</div>